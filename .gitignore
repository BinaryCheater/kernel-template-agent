# Environments and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.import_linter_cache/
node_modules/
web/dist/

# Data, databases, logs, workspaces, artifacts (spec/conventions.md §1, §5)
data/
# The web frontend's API client is source, not data.
!web/src/data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
logs/
*.log
*.jsonl
workspaces/
agent-home/
objects/
artifacts/

# Secrets (spec/conventions.md §8)
.env
.env.*
secrets.env
*.pem
*.key

# OS
.DS_Store

# Project-local interpreters (scripts/bootstrap)
.uv/

# Agent worktrees and local tool state
.claude/

# Project-local Codex settings
.codex/

# Study run state (knowledge/studies/README.md): local, not disposable, never committed.
# Tracked: inputs/sources.json and the checkers (checks/*.py, *.md).
knowledge/studies/*/inputs/*
!knowledge/studies/*/inputs/sources.json
knowledge/studies/*/checks/*.json
knowledge/studies/*/checks/*.txt

# PERFMODEL: compiled kernels and the generated table: local, not disposable (D914).
# Tracked for each batch: batch.json, build.json, entry.md, measured.json, predicted.json.
perfmodel/batches/*/build/
docs/design/perfmodel/error-table.json
