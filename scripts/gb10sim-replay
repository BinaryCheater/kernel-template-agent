#!/usr/bin/env -S uv run --frozen --quiet python
"""Replay the copied GB10 simulator's validation sets (WP26, D681) on a calibration directory.

    scripts/gb10sim-replay --calibration DIR --out FILE [--set block|kernel|tma] [name ...]

DIR is a copy of upstream AI-Infra-Co-Design calibration/spark-6951 (at least gb10.json, sass/,
ablation_cpasync/, ablation/). Writes the rows and their summary as JSON to FILE and prints one
line per row. CPU only; run it on a worker (slai), not on the control plane.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import sys
import time
from pathlib import Path

from kta.models.gb10sim import validate, ws_validate


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--calibration", type=Path, required=True)
    ap.add_argument("--out", type=Path, required=True)
    ap.add_argument("--set", choices=("block", "kernel", "tma"), default="block")
    ap.add_argument("names", nargs="*")
    a = ap.parse_args()
    if a.out.exists():
        print(f"refusing to overwrite {a.out}", file=sys.stderr)
        return 2
    t0 = time.time()
    names = a.names or None
    if a.set == "block":
        rows = validate.block_level(a.calibration, names)
        summary = validate.summary(rows, ("full", "noload", "nocompute"))
    elif a.set == "kernel":
        rows = validate.kernel_level(a.calibration, names)
        summary = validate.summary(rows, ("full", "nocompute"))
    else:
        rows = ws_validate.ws_level(a.calibration, names)
        summary = validate.summary(rows, ("noload", "full"))
    for r in rows:
        print(json.dumps(r))
    params = Path(validate.__file__).with_name("gb10.json").read_bytes()
    a.out.write_text(
        json.dumps(
            {
                "set": a.set,
                "calibration": str(a.calibration),
                "params_sha256": hashlib.sha256(params).hexdigest(),
                "wall_s": round(time.time() - t0, 1),
                "summary": summary,
                "rows": rows,
            },
            indent=1,
        )
    )
    print(json.dumps(summary))
    return 0


if __name__ == "__main__":
    sys.exit(main())
